@model CSI402_Project.Models.Db.Product
@{
    ViewData["Title"] = "เพิ่มสินค้าใหม่";
    Layout = "_AdminLayout";
}

<style>
    .form-section {
        background: #fff;
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        border: 1px solid #f0f0f0;
    }
    .form-section-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #2d3436;
        margin-bottom: 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid #e9ecef;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .form-section-title i {
        color: #FF6B6B;
        font-size: 1.25rem;
    }
    .image-preview-box {
        width: 100%;
        height: 220px;
        border: 2px dashed #dee2e6;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
        margin-bottom: 1rem;
        overflow: hidden;
        transition: all 0.3s ease;
    }
    .image-preview-box:hover {
        border-color: #FF6B6B;
        background: #fff5f5;
    }
    .image-preview-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .image-preview-box .placeholder {
        text-align: center;
        color: #adb5bd;
    }
    .image-preview-box .placeholder i {
        font-size: 3.5rem;
        margin-bottom: 0.5rem;
    }
    .additional-image-item {
        background: #fff;
        border-radius: 12px;
        padding: 1rem;
        margin-bottom: 1rem;
        border: 1px solid #e9ecef;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }
    .additional-image-preview {
        width: 100%;
        height: 140px;
        border-radius: 8px;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.75rem;
        overflow: hidden;
        border: 1px dashed #dee2e6;
    }
    .additional-image-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .btn-add-image {
        border: 2px dashed #dee2e6;
        background: #fff;
        color: #6c757d;
        width: 100%;
        padding: 1.25rem;
        border-radius: 12px;
        transition: all 0.3s ease;
        font-weight: 500;
    }
    .btn-add-image:hover {
        border-color: #FF6B6B;
        color: #FF6B6B;
        background: #fff5f5;
    }
    .page-header {
        background: linear-gradient(135deg, #fff 0%, #fff5f5 100%);
        border-radius: 16px;
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
        border: 1px solid #f0f0f0;
    }
    .form-label {
        font-weight: 500;
        color: #495057;
        margin-bottom: 0.5rem;
    }
    .input-group-text {
        border-color: #dee2e6;
    }
    .btn-action {
        padding: 0.75rem 2rem;
        font-weight: 600;
        border-radius: 10px;
    }
</style>

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="page-header d-flex align-items-center">
        <a asp-action="Products" class="btn btn-outline-secondary rounded-circle me-4" style="width: 44px; height: 44px; padding: 0; display: flex; align-items: center; justify-content: center;">
            <i class="bi bi-arrow-left fs-5"></i>
        </a>
        <div>
            <h1 class="h3 mb-1 fw-bold">
                <i class="bi bi-plus-circle-fill me-2 text-primary"></i>เพิ่มสินค้าใหม่
            </h1>
            <p class="text-muted mb-0">กรอกข้อมูลสินค้าให้ครบถ้วนเพื่อเพิ่มลงในระบบ</p>
        </div>
    </div>

    <form asp-action="CreateProduct" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>

        <div class="row g-4">
            <!-- Left Column - Basic Info -->
            <div class="col-lg-8">
                <!-- Basic Information Section -->
                <div class="form-section">
                    <div class="form-section-title">
                        <i class="bi bi-info-circle-fill"></i>
                        ข้อมูลพื้นฐาน
                    </div>
                    <div class="row g-4">
                        <div class="col-md-12">
                            <label asp-for="Name" class="form-label">
                                <i class="bi bi-tag me-1 text-primary"></i>ชื่อสินค้า <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control form-control-lg" placeholder="เช่น จักรยานเด็ก 3 ล้อ สีแดง" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label">
                                <i class="bi bi-folder me-1 text-primary"></i>หมวดหมู่ <span class="text-danger">*</span>
                            </label>
                            <select asp-for="CategoryId" class="form-select form-select-lg" required>
                                <option value="">-- เลือกหมวดหมู่ --</option>
                                @foreach (var cat in ViewBag.Categories)
                                {
                                    <option value="@cat.CategoryId">@cat.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label">
                                <i class="bi bi-currency-dollar me-1 text-primary"></i>ราคา <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light">฿</span>
                                <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Stock" class="form-label">
                                <i class="bi bi-box-seam me-1 text-primary"></i>จำนวนสต็อก <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light"><i class="bi bi-stack"></i></span>
                                <input asp-for="Stock" type="number" class="form-control" placeholder="0" required />
                                <span class="input-group-text bg-light">ชิ้น</span>
                            </div>
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Description Section -->
                <div class="form-section">
                    <div class="form-section-title">
                        <i class="bi bi-file-text-fill"></i>
                        รายละเอียดสินค้า
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">
                            <i class="bi bi-card-text me-1 text-primary"></i>คำอธิบายสินค้า
                        </label>
                        <textarea asp-for="Description" class="form-control" rows="6" placeholder="รายละเอียดสินค้า เช่น คุณสมบัติ ขนาด วัสดุ ฯลฯ..."></textarea>
                        <div class="form-text text-muted mt-2">
                            <i class="bi bi-info-circle me-1"></i>ข้อมูลนี้จะแสดงในหน้ารายละเอียดสินค้า
                        </div>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- Right Column - Images -->
            <div class="col-lg-4">
                <!-- Main Image -->
                <div class="form-section">
                    <div class="form-section-title">
                        <i class="bi bi-image-fill"></i>
                        รูปภาพหลัก
                    </div>
                    <div class="image-preview-box" id="mainImagePreview" onclick="document.getElementById('mainImageFile').click()" style="cursor: pointer;">
                        <div class="placeholder">
                            <i class="bi bi-cloud-upload text-muted"></i>
                            <div class="small mt-2">คลิกเพื่ออัปโหลดรูปภาพ</div>
                            <div class="small text-muted">(หรือลากไฟล์มาวาง)</div>
                        </div>
                    </div>
                    <input type="file" id="mainImageFile" name="MainImageFile" class="d-none" accept="image/*" onchange="previewMainImage(this)" />
                    <div class="mb-0">
                        <label class="form-label small text-muted d-flex justify-content-between">
                            <span>หรือใส่ URL</span>
                            <small class="text-primary" style="cursor: pointer;" onclick="toggleMainImageInput()">สลับเป็น URL</small>
                        </label>
                        <div class="input-group" id="mainImageUrlGroup" style="display: none;">
                            <span class="input-group-text bg-light"><i class="bi bi-link-45deg"></i></span>
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://..." onchange="updateMainImagePreview(this.value)" />
                        </div>
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Additional Images -->
                <div class="form-section">
                    <div class="form-section-title">
                        <i class="bi bi-images"></i>
                        รูปภาพเพิ่มเติม
                        <span class="badge bg-light text-dark border ms-auto" style="font-size: 0.7rem;">แสดงในหน้ารายละเอียด</span>
                    </div>
                    <div id="additionalImages">
                        <!-- Dynamic image inputs will be added here -->
                    </div>
                    <button type="button" class="btn btn-add-image" onclick="addImageInput()">
                        <i class="bi bi-plus-lg me-2"></i>เพิ่มรูปภาพ
                    </button>
                </div>

                <!-- Action Buttons -->
                <div class="d-grid gap-3">
                    <button type="submit" class="btn btn-primary btn-action">
                        <i class="bi bi-check-circle me-2"></i>บันทึกสินค้า
                    </button>
                    <a asp-action="Products" class="btn btn-outline-secondary btn-action">
                        <i class="bi bi-x-circle me-2"></i>ยกเลิก
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let imageCounter = 0;

        function updateMainImagePreview(url) {
            const preview = document.getElementById('mainImagePreview');
            if (url && url.trim() !== '') {
                preview.innerHTML = `<img src="${url}" alt="Preview" onerror="showMainPlaceholder();">`;
            } else {
                showMainPlaceholder();
            }
        }

        function showMainPlaceholder() {
            const preview = document.getElementById('mainImagePreview');
            preview.innerHTML = `
                <div class="placeholder">
                    <i class="bi bi-cloud-upload text-muted"></i>
                    <div class="small mt-2">คลิกเพื่ออัปโหลดรูปภาพ</div>
                    <div class="small text-muted">(หรือลากไฟล์มาวาง)</div>
                </div>
            `;
        }

        function previewMainImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const preview = document.getElementById('mainImagePreview');
                    preview.innerHTML = `<img src="${e.target.result}" alt="Preview">`;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function toggleMainImageInput() {
            const urlGroup = document.getElementById('mainImageUrlGroup');
            const fileInput = document.getElementById('mainImageFile');
            if (urlGroup.style.display === 'none') {
                urlGroup.style.display = 'flex';
                fileInput.value = '';
                showMainPlaceholder();
            } else {
                urlGroup.style.display = 'none';
                document.querySelector('[name="ImageUrl"]').value = '';
            }
        }

        // Drag and drop support
        const mainImagePreview = document.getElementById('mainImagePreview');
        if (mainImagePreview) {
            mainImagePreview.addEventListener('dragover', (e) => {
                e.preventDefault();
                mainImagePreview.style.borderColor = '#FF6B6B';
                mainImagePreview.style.background = '#fff5f5';
            });
            mainImagePreview.addEventListener('dragleave', (e) => {
                e.preventDefault();
                mainImagePreview.style.borderColor = '#dee2e6';
                mainImagePreview.style.background = '#f8f9fa';
            });
            mainImagePreview.addEventListener('drop', (e) => {
                e.preventDefault();
                mainImagePreview.style.borderColor = '#dee2e6';
                mainImagePreview.style.background = '#f8f9fa';
                const files = e.dataTransfer.files;
                if (files.length > 0) {
                    const fileInput = document.getElementById('mainImageFile');
                    fileInput.files = files;
                    previewMainImage(fileInput);
                }
            });
        }

        function addImageInput() {
            imageCounter++;
            const container = document.getElementById('additionalImages');
            const div = document.createElement('div');
            div.className = 'additional-image-item';
            div.id = `image-item-${imageCounter}`;
            div.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <small class="text-muted fw-semibold">รูปที่ ${container.children.length + 1}</small>
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill" onclick="removeImageInput('image-item-${imageCounter}')">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
                <div class="additional-image-preview" id="preview-${imageCounter}" onclick="document.getElementById('additionalFile-${imageCounter}').click()" style="cursor: pointer;">
                    <div class="text-center text-muted">
                        <i class="bi bi-cloud-upload" style="font-size: 2rem;"></i>
                        <div class="small mt-1">คลิกอัปโหลด</div>
                    </div>
                </div>
                <input type="file" id="additionalFile-${imageCounter}" name="AdditionalImageFiles" class="d-none" accept="image/*" onchange="previewAdditionalImage(this, 'preview-${imageCounter}')" />
                <div class="mt-2">
                    <small class="text-muted">หรือ</small>
                </div>
                <div class="input-group input-group-sm mt-1">
                    <span class="input-group-text bg-light"><i class="bi bi-link-45deg"></i></span>
                    <input type="text" name="AdditionalImageUrls" class="form-control" placeholder="URL รูปภาพ..." 
                           onchange="updateAdditionalImagePreview(this.value, 'preview-${imageCounter}')" />
                </div>
            `;
            container.appendChild(div);
        }

        function previewAdditionalImage(input, previewId) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const preview = document.getElementById(previewId);
                    preview.innerHTML = `<img src="${e.target.result}" alt="Preview">`;
                    preview.style.border = 'none';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function updateAdditionalImagePreview(url, previewId) {
            const preview = document.getElementById(previewId);
            if (url && url.trim() !== '') {
                preview.innerHTML = `<img src="${url}" alt="Preview" onerror="this.src='/images/bike-placeholder.jpg';">`;
                preview.style.border = 'none';
            }
        }

        function removeImageInput(elementId) {
            document.getElementById(elementId).remove();
            const items = document.querySelectorAll('.additional-image-item');
            items.forEach((item, index) => {
                const label = item.querySelector('small');
                if (label) label.textContent = `รูปที่ ${index + 1}`;
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            addImageInput();
        });
    </script>
}

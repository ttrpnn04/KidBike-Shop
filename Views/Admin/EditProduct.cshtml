@model CSI402_Project.ViewModels.ProductFormViewModel
@{
    ViewData["Title"] = "แก้ไขสินค้า";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Products" class="btn btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="mb-0">
            <i class="bi bi-pencil me-2 text-primary"></i>แก้ไขสินค้า
        </h1>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-action="EditProduct" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Product.ProductId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="Product.Name" class="form-label">ชื่อสินค้า</label>
                                <input asp-for="Product.Name" class="form-control" required />
                                <span asp-validation-for="Product.Name" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Product.CategoryId" class="form-label">หมวดหมู่</label>
                                <select asp-for="Product.CategoryId" class="form-select" required>
                                    <option value="">-- เลือกหมวดหมู่ --</option>
                                    @foreach (var cat in Model.Categories)
                                    {
                                        <option value="@cat.CategoryId" selected="@(Model.Product.CategoryId == cat.CategoryId ? "selected" : null)">@cat.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="Product.CategoryId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Product.Price" class="form-label">ราคา (บาท)</label>
                                <input asp-for="Product.Price" type="number" step="0.01" class="form-control" required />
                                <span asp-validation-for="Product.Price" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Product.Stock" class="form-label">จำนวนสต็อก</label>
                                <input asp-for="Product.Stock" type="number" class="form-control" required />
                                <span asp-validation-for="Product.Stock" class="text-danger"></span>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label">รูปภาพสินค้า</label>
                                <div class="card">
                                    <div class="card-header bg-light">
                                        <small class="text-muted">รูปภาพหลัก (แสดงในหน้ารายการสินค้า)</small>
                                    </div>
                                    <div class="card-body">
                                        <input asp-for="Product.ImageUrl" class="form-control" />
                                        <span asp-validation-for="Product.ImageUrl" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label">รูปภาพเพิ่มเติม (แสดงในหน้ารายละเอียด)</label>
                                <div id="additionalImages">
                                    @if (Model.Product.ProductImages != null && Model.Product.ProductImages.Any())
                                    {
                                        @foreach (var image in Model.Product.ProductImages.OrderBy(pi => pi.DisplayOrder))
                                        {
                                            <div class="input-group mb-2 image-input">
                                                <input type="hidden" name="ExistingImageIds" value="@image.ProductImageId" />
                                                <input type="text" name="ExistingImageUrls" class="form-control" value="@image.ImageUrl" placeholder="URL รูปภาพเพิ่มเติม..." />
                                                <button type="button" class="btn btn-outline-secondary" onclick="removeImageInput(this)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        }
                                    }
                                    <div class="input-group mb-2 image-input">
                                        <input type="text" name="AdditionalImageUrls" class="form-control" placeholder="URL รูปภาพเพิ่มเติมใหม่..." />
                                        <button type="button" class="btn btn-outline-secondary" onclick="removeImageInput(this)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-outline-primary btn-sm" onclick="addImageInput()">
                                    <i class="bi bi-plus-lg me-1"></i>เพิ่มรูปภาพ
                                </button>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Product.Description" class="form-label">รายละเอียด</label>
                                <textarea asp-for="Product.Description" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="Product.Description" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <a asp-action="Products" class="btn btn-outline-secondary">ยกเลิก</a>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-check-lg me-2"></i>บันทึกการเปลี่ยนแปลง
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function addImageInput() {
            var container = document.getElementById('additionalImages');
            var div = document.createElement('div');
            div.className = 'input-group mb-2 image-input';
            div.innerHTML = `
                <input type="text" name="AdditionalImageUrls" class="form-control" placeholder="URL รูปภาพเพิ่มเติมใหม่..." />
                <button type="button" class="btn btn-outline-secondary" onclick="removeImageInput(this)">
                    <i class="bi bi-trash"></i>
                </button>
            `;
            container.appendChild(div);
        }

        function removeImageInput(button) {
            var container = document.getElementById('additionalImages');
            var imageInput = button.closest('.image-input');
            
            // Check if this is an existing image (has hidden input with ExistingImageIds)
            var hasExistingId = imageInput.querySelector('input[name="ExistingImageIds"]') !== null;
            
            if (hasExistingId || container.children.length > 1) {
                imageInput.remove();
            } else {
                // Clear the input instead of removing the last new one
                button.closest('.image-input').querySelector('input[name="AdditionalImageUrls"]').value = '';
            }
        }
    </script>
}

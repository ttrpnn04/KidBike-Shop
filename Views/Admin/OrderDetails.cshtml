@model CSI402_Project.Models.Db.Order
@{
    ViewData["Title"] = $"รายละเอียดคำสั่งซื้อ #{Model.OrderId}";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Orders" class="btn btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="mb-0">
            <i class="bi bi-bag me-2 text-primary"></i>รายละเอียดคำสั่งซื้อ #@Model.OrderId
        </h1>
    </div>

    <div class="row g-4">
        <!-- Order Info -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0">ข้อมูลคำสั่งซื้อ</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="text-muted small">สถานะ</label>
                        <form asp-action="UpdateOrderStatus" method="post" class="mt-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderId" value="@Model.OrderId" />
                            <div class="input-group">
                                <select name="status" class="form-select">
                                    <option value="Pending" selected="@(Model.Status == "Pending" ? "selected" : null)">รอดำเนินการ</option>
                                    <option value="Paid" selected="@(Model.Status == "Paid" ? "selected" : null)">ชำระเงินแล้ว</option>
                                    <option value="Shipping" selected="@(Model.Status == "Shipping" ? "selected" : null)">กำลังจัดส่ง</option>
                                    <option value="Completed" selected="@(Model.Status == "Completed" ? "selected" : null)">สำเร็จ</option>
                                    <option value="Cancelled" selected="@(Model.Status == "Cancelled" ? "selected" : null)">ยกเลิก</option>
                                </select>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-lg"></i>
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small">วันที่สั่งซื้อ</label>
                        <p class="mb-0 fw-semibold">@Model.OrderDate?.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small">ลูกค้า</label>
                        <p class="mb-0 fw-semibold">@Model.User?.Username</p>
                        <small class="text-muted">@Model.User?.Email</small>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small">เบอร์โทร</label>
                        <p class="mb-0 fw-semibold">@Model.User?.Phone</p>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small">ที่อยู่จัดส่ง</label>
                        <p class="mb-0">@Model.User?.Address</p>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">ยอดรวม</span>
                        <span class="fs-4 fw-bold text-primary">฿@Model.TotalAmount?.ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Items -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0">รายการสินค้า</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>สินค้า</th>
                                    <th class="text-center">จำนวน</th>
                                    <th class="text-end">ราคาต่อหน่วย</th>
                                    <th class="text-end">รวม</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderDetails)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@(string.IsNullOrEmpty(item.Product?.ImageUrl) ? "/images/bike-placeholder.jpg" : item.Product?.ImageUrl)" 
                                                     class="rounded me-3" style="width: 50px; height: 50px; object-fit: cover;" />
                                                <div>
                                                    <strong>@item.Product?.Name</strong>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">฿@(item.Price?.ToString("N2") ?? "0.00")</td>
                                        <td class="text-end fw-semibold">฿@((item.Quantity ?? 0) * (item.Price ?? 0)).ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="3" class="text-end fw-bold">ยอดรวมทั้งหมด:</td>
                                    <td class="text-end fw-bold fs-5 text-primary">฿@Model.TotalAmount?.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

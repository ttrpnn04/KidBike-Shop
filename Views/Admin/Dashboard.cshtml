@model CSI402_Project.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "แดชบอร์ด - ผู้ดูแลระบบ";
    Layout = "_AdminLayout";
}

<div class="container-fluid pt-0 pb-4">
    <h1 class="mb-4 mt-0" style="margin-top: 0 !important;">
        <i class="bi bi-speedometer2 me-2 text-primary"></i>แดชบอร์ด
    </h1>

    <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">สินค้าทั้งหมด</h6>
                            <h3 class="mb-0">@Model.TotalProducts</h3>
                        </div>
                        <i class="bi bi-bicycle fs-1 opacity-75"></i>
                    </div>
                    <a asp-action="Products" class="text-white text-decoration-none small">
                        <i class="bi bi-arrow-right me-1"></i>จัดการสินค้า
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #4ECDC4 0%, #6EDDD6 100%);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">หมวดหมู่</h6>
                            <h3 class="mb-0">@Model.TotalCategories</h3>
                        </div>
                        <i class="bi bi-grid fs-1 opacity-75"></i>
                    </div>
                    <a asp-action="Categories" class="text-white text-decoration-none small">
                        <i class="bi bi-arrow-right me-1"></i>จัดการหมวดหมู่
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #54A0FF 0%, #74B9FF 100%);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">คำสั่งซื้อ</h6>
                            <h3 class="mb-0">@Model.TotalOrders</h3>
                        </div>
                        <i class="bi bi-bag fs-1 opacity-75"></i>
                    </div>
                    <a asp-action="Orders" class="text-white text-decoration-none small">
                        <i class="bi bi-arrow-right me-1"></i>จัดการคำสั่งซื้อ
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #1DD1A1 0%, #4CD9B0 100%);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">ผู้ใช้งาน</h6>
                            <h3 class="mb-0">@Model.TotalUsers</h3>
                        </div>
                        <i class="bi bi-people fs-1 opacity-75"></i>
                    </div>
                    <a asp-controller="SuperAdmin" asp-action="Users" class="text-white text-decoration-none small">
                        <i class="bi bi-arrow-right me-1"></i>จัดการผู้ใช้
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Recent Orders -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-clock-history me-2 text-primary"></i>คำสั่งซื้อล่าสุด
                        </h5>
                        <a asp-action="Orders" class="btn btn-sm btn-outline-primary">ดูทั้งหมด</a>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>เลขที่</th>
                                    <th>ลูกค้า</th>
                                    <th>วันที่</th>
                                    <th>ยอดรวม</th>
                                    <th>สถานะ</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.RecentOrders)
                                {
                                    <tr>
                                        <td>#@order.OrderId</td>
                                        <td>@order.User?.Username</td>
                                        <td>@order.OrderDate?.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>฿@order.TotalAmount?.ToString("N2")</td>
                                        <td>
                                            <span class="badge @GetStatusBadgeClass(order.Status)">
                                                @GetStatusText(order.Status)
                                            </span>
                                        </td>
                                        <td>
                                            <a asp-action="OrderDetails" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Low Stock Products -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-exclamation-triangle me-2 text-warning"></i>สินค้าใกล้หมด
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @foreach (var product in Model.LowStockProducts)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1">@product.Name</h6>
                                    <small class="text-muted">เหลือ @product.Stock ชิ้น</small>
                                </div>
                                <a asp-action="EditProduct" asp-route-id="@product.ProductId" class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>
                <div class="card-footer bg-white border-0">
                    <a asp-action="Products" class="btn btn-outline-primary w-100">
                        <i class="bi bi-box-seam me-2"></i>จัดการสต็อก
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusBadgeClass(string? status)
    {
        return status switch
        {
            "Pending" => "bg-warning text-dark",
            "Paid" => "bg-info",
            "Shipping" => "bg-primary",
            "Completed" => "bg-success",
            "Cancelled" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    string GetStatusText(string? status)
    {
        return status switch
        {
            "Pending" => "รอดำเนินการ",
            "Paid" => "ชำระเงินแล้ว",
            "Shipping" => "กำลังจัดส่ง",
            "Completed" => "สำเร็จ",
            "Cancelled" => "ยกเลิก",
            _ => status ?? "ไม่ระบุ"
        };
    }
}

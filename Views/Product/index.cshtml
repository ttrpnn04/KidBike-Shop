@model List<CSI402_Project.Models.Db.Product>
@{
    ViewData["Title"] = string.IsNullOrEmpty(ViewBag.CategoryName) ? "สินค้าทั้งหมด" : ViewBag.CategoryName;
    var search = ViewBag.Search as string;
    var categoryId = ViewBag.CategoryId as int?;
    var priceRange = ViewBag.PriceRange as string;
    var sortBy = ViewBag.SortBy as string ?? "default";
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var totalItems = ViewBag.TotalItems as int? ?? 0;
    var categories = ViewBag.Categories as List<CSI402_Project.Models.Db.Category> ?? new List<CSI402_Project.Models.Db.Category>();
}

<!-- Breadcrumb -->
<div class="container py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">หน้าแรก</a></li>
            @if (!string.IsNullOrEmpty(ViewBag.CategoryName))
            {
                <li class="breadcrumb-item"><a asp-controller="Category" asp-action="Index">หมวดหมู่</a></li>
                <li class="breadcrumb-item active" aria-current="page">@ViewBag.CategoryName</li>
            }
            else
            {
                <li class="breadcrumb-item active" aria-current="page">สินค้าทั้งหมด</li>
            }
        </ol>
    </nav>
</div>

<!-- Page Header -->
<div class="container mb-4">
    <div class="section-header">
        <h1 class="section-title">
            @(string.IsNullOrEmpty(ViewBag.CategoryName) ? "สินค้าทั้งหมด" : ViewBag.CategoryName)
        </h1>
        <p class="section-subtitle">เลือกจักรยานเด็กที่เหมาะสมกับลูกน้อยของคุณ</p>
    </div>
</div>

<div class="container">
    <div class="row">
        <!-- Sidebar Filters -->
        <div class="col-lg-3 mb-4">
            <div class="filter-section">
                <div class="filter-title">
                    <i class="bi bi-funnel"></i>
                    กรองสินค้า
                </div>
                
                <!-- Search Form -->
                <form method="get" asp-action="Index" class="mb-3">
                    <div class="input-group">
                        <input type="text" name="search" class="form-control" placeholder="ค้นหาสินค้า..." value="@search">
                        @if (categoryId.HasValue)
                        {
                            <input type="hidden" name="categoryId" value="@categoryId" />
                        }
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>
                
                <!-- Categories -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">หมวดหมู่</label>
                    <div class="d-flex flex-wrap">
                        <a asp-action="Index" asp-route-search="@search" asp-route-priceRange="@priceRange" asp-route-sortBy="@sortBy" 
                           class="filter-option @(categoryId == null ? "active" : "")">ทั้งหมด</a>
                        @foreach (var cat in categories)
                        {
                            <a asp-action="Index" asp-route-categoryId="@cat.CategoryId" asp-route-search="@search" asp-route-priceRange="@priceRange" asp-route-sortBy="@sortBy"
                               class="filter-option @(categoryId == cat.CategoryId ? "active" : "")">@cat.Name</a>
                        }
                    </div>
                </div>
                
                <!-- Price Range -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">ราคา</label>
                    <div class="d-flex flex-wrap">
                        <a asp-action="Index" asp-route-categoryId="@categoryId" asp-route-search="@search" asp-route-sortBy="@sortBy"
                           class="filter-option @(string.IsNullOrEmpty(priceRange) ? "active" : "")">ทั้งหมด</a>
                        <a asp-action="Index" asp-route-categoryId="@categoryId" asp-route-search="@search" asp-route-priceRange="under2000" asp-route-sortBy="@sortBy"
                           class="filter-option @(priceRange == "under2000" ? "active" : "")">ต่ำกว่า 2,000</a>
                        <a asp-action="Index" asp-route-categoryId="@categoryId" asp-route-search="@search" asp-route-priceRange="2000-3000" asp-route-sortBy="@sortBy"
                           class="filter-option @(priceRange == "2000-3000" ? "active" : "")">2,000 - 3,000</a>
                        <a asp-action="Index" asp-route-categoryId="@categoryId" asp-route-search="@search" asp-route-priceRange="3000-5000" asp-route-sortBy="@sortBy"
                           class="filter-option @(priceRange == "3000-5000" ? "active" : "")">3,000 - 5,000</a>
                        <a asp-action="Index" asp-route-categoryId="@categoryId" asp-route-search="@search" asp-route-priceRange="over5000" asp-route-sortBy="@sortBy"
                           class="filter-option @(priceRange == "over5000" ? "active" : "")">มากกว่า 5,000</a>
                    </div>
                </div>
                
                <!-- Clear Filters -->
                @if (!string.IsNullOrEmpty(search) || categoryId.HasValue || !string.IsNullOrEmpty(priceRange))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-x-circle me-2"></i>ล้างตัวกรอง
                    </a>
                }
            </div>
        </div>
        
        <!-- Product Grid -->
        <div class="col-lg-9">
            <!-- Search & Sort Bar -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
                <div class="search-box flex-grow-1" style="max-width: 400px;">
                    <form method="get" asp-action="Index" class="d-flex">
                        <input type="text" name="search" class="form-control" placeholder="ค้นหาสินค้า..." value="@search">
                        @if (categoryId.HasValue)
                        {
                            <input type="hidden" name="categoryId" value="@categoryId" />
                        }
                        @if (!string.IsNullOrEmpty(priceRange))
                        {
                            <input type="hidden" name="priceRange" value="@priceRange" />
                        }
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                </div>
                
                <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
                    @if (categoryId.HasValue)
                    {
                        <input type="hidden" name="categoryId" value="@categoryId" />
                    }
                    @if (!string.IsNullOrEmpty(search))
                    {
                        <input type="hidden" name="search" value="@search" />
                    }
                    @if (!string.IsNullOrEmpty(priceRange))
                    {
                        <input type="hidden" name="priceRange" value="@priceRange" />
                    }
                    <span class="text-muted">เรียงตาม:</span>
                    <select name="sortBy" class="form-select" style="width: auto;" onchange="this.form.submit()">
                        @if (sortBy == "default")
                        {
                            <option value="default" selected>ยอดนิยม</option>
                        }
                        else
                        {
                            <option value="default">ยอดนิยม</option>
                        }
                        @if (sortBy == "price-asc")
                        {
                            <option value="price-asc" selected>ราคาต่ำ-สูง</option>
                        }
                        else
                        {
                            <option value="price-asc">ราคาต่ำ-สูง</option>
                        }
                        @if (sortBy == "price-desc")
                        {
                            <option value="price-desc" selected>ราคาสูง-ต่ำ</option>
                        }
                        else
                        {
                            <option value="price-desc">ราคาสูง-ต่ำ</option>
                        }
                        @if (sortBy == "name")
                        {
                            <option value="name" selected>ชื่อ A-Z</option>
                        }
                        else
                        {
                            <option value="name">ชื่อ A-Z</option>
                        }
                        @if (sortBy == "newest")
                        {
                            <option value="newest" selected>สินค้าใหม่</option>
                        }
                        else
                        {
                            <option value="newest">สินค้าใหม่</option>
                        }
                    </select>
                </form>
            </div>
            
            <!-- Active Filters -->
            @if (!string.IsNullOrEmpty(search) || categoryId.HasValue || !string.IsNullOrEmpty(priceRange))
            {
                <div class="mb-3">
                    <span class="text-muted">ตัวกรองที่ใช้:</span>
                    @if (!string.IsNullOrEmpty(search))
                    {
                        <span class="badge bg-primary me-1">
                            ค้นหา: @search
                            <a asp-action="Index" asp-route-categoryId="@categoryId" asp-route-priceRange="@priceRange" asp-route-sortBy="@sortBy" class="text-white text-decoration-none ms-1">×</a>
                        </span>
                    }
                    @if (categoryId.HasValue)
                    {
                        <span class="badge bg-info me-1">
                            @ViewBag.CategoryName
                            <a asp-action="Index" asp-route-search="@search" asp-route-priceRange="@priceRange" asp-route-sortBy="@sortBy" class="text-white text-decoration-none ms-1">×</a>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(priceRange))
                    {
                        var priceLabel = priceRange switch
                        {
                            "under2000" => "ต่ำกว่า 2,000",
                            "2000-3000" => "2,000 - 3,000",
                            "3000-5000" => "3,000 - 5,000",
                            "over5000" => "มากกว่า 5,000",
                            _ => priceRange
                        };
                        <span class="badge bg-warning text-dark me-1">
                            ราคา: @priceLabel
                            <a asp-action="Index" asp-route-search="@search" asp-route-categoryId="@categoryId" asp-route-sortBy="@sortBy" class="text-dark text-decoration-none ms-1">×</a>
                        </span>
                    }
                </div>
            }
            
            <!-- Results Count -->
            <p class="text-muted mb-3">แสดง @Model.Count จาก @totalItems สินค้า</p>
            
            @if (Model.Count == 0)
            {
                <div class="alert alert-info text-center py-5">
                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                    <h5>ไม่พบสินค้า</h5>
                    <p class="mb-3">ลองเปลี่ยนคำค้นหาหรือตัวกรอง</p>
                    <a asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>แสดงสินค้าทั้งหมด
                    </a>
                </div>
            }
            else
            {
                <!-- Products -->
                <div class="row g-4">
                    @foreach (var item in Model)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card product-card h-100">
                                @if (item.Stock < 10 && item.Stock > 0)
                                {
                                    <span class="product-badge badge-hot">เหลือน้อย</span>
                                }
                                @if (item.Stock == 0)
                                {
                                    <span class="product-badge bg-secondary">สินค้าหมด</span>
                                }
                                <a asp-action="Details" asp-route-id="@item.ProductId" class="text-decoration-none">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/bike-placeholder.jpg" : item.ImageUrl)" 
                                         class="card-img-top" alt="@item.Name"
                                         onerror="this.src='/images/bike-placeholder.jpg'">
                                </a>
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">
                                        <a asp-action="Details" asp-route-id="@item.ProductId" class="text-decoration-none text-dark">@item.Name</a>
                                    </h5>
                                    @if (item.Category != null)
                                    {
                                        <span class="badge bg-light text-dark mb-2">@item.Category.Name</span>
                                    }
                                    <p class="text-muted small mb-2">
                                        @if (item.Stock > 0)
                                        {
                                            <i class="bi bi-check-circle-fill text-success me-1"></i>
                                            <span>มีสินค้า @item.Stock ชิ้น</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-x-circle-fill text-danger me-1"></i>
                                            <span>สินค้าหมด</span>
                                        }
                                    </p>
                                    <div class="mt-auto">
                                        <div class="d-flex align-items-baseline mb-3">
                                            <span class="card-price">฿@item.Price.ToString("N0")</span>
                                        </div>
                                        <div class="d-grid gap-2 product-actions">
                                            @if (item.Stock > 0)
                                            {
                                                <form asp-controller="Cart" asp-action="Add" method="post" class="d-grid">
                                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                                    <input type="hidden" name="quantity" value="1" />
                                                    <button type="submit" class="btn btn-primary">
                                                        <i class="bi bi-cart-plus me-2"></i>เพิ่มลงตะกร้า
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <button class="btn btn-secondary" disabled>
                                                    <i class="bi bi-cart-x me-2"></i>สินค้าหมด
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                
                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <nav class="mt-5">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-categoryId="@categoryId" asp-route-search="@search" asp-route-priceRange="@priceRange" asp-route-sortBy="@sortBy">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-categoryId="@categoryId" asp-route-search="@search" asp-route-priceRange="@priceRange" asp-route-sortBy="@sortBy">@i</a>
                                </li>
                            }
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-categoryId="@categoryId" asp-route-search="@search" asp-route-priceRange="@priceRange" asp-route-sortBy="@sortBy">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>

<!-- Promotion Banner -->
<div class="container mt-5">
    <div class="promo-banner">
        <h3 class="promo-title">🎉 โปรโมชั่นสมาชิกใหม่!</h3>
        <p class="mb-0">ลดทันที 100 บาท เมื่อสมัครสมาชิกและซื้อสินค้าครั้งแรก</p>
        <div class="promo-code">WELCOME100</div>
    </div>
</div>
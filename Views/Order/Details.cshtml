@model CSI402_Project.Models.Db.Order
@{
    ViewData["Title"] = "รายละเอียดคำสั่งซื้อ #" + Model.OrderId.ToString("D5");
    
    string GetStatusBadgeClass(string? status)
    {
        return status?.ToLower() switch
        {
            "รอดำเนินการ" => "bg-warning text-dark",
            "กำลังจัดส่ง" => "bg-info text-dark",
            "จัดส่งสำเร็จ" => "bg-success",
            "ยกเลิก" => "bg-danger",
            _ => "bg-secondary"
        };
    }
    
    var subtotal = Model.OrderDetails?.Sum(od => (od.Price ?? 0) * (od.Quantity ?? 0)) ?? 0;
    var totalItems = Model.OrderDetails?.Sum(od => od.Quantity ?? 0) ?? 0;
}

<!-- Breadcrumb -->
<div class="container py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">หน้าแรก</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">คำสั่งซื้อของฉัน</a></li>
            <li class="breadcrumb-item active" aria-current="page">#@Model.OrderId.ToString("D5")</li>
        </ol>
    </nav>
</div>

<!-- Page Header -->
<div class="container mb-4">
    <div class="section-header d-flex justify-content-between align-items-center flex-wrap">
        <div>
            <h1 class="section-title">
                <i class="bi bi-receipt text-primary me-2"></i>รายละเอียดคำสั่งซื้อ
            </h1>
            <p class="section-subtitle mb-0">หมายเลขคำสั่งซื้อ #@Model.OrderId.ToString("D5")</p>
        </div>
        <span class="badge @GetStatusBadgeClass(Model.Status) px-3 py-2 fs-6 mt-2 mt-md-0">
            <i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i>@Model.Status
        </span>
    </div>
</div>

<div class="container">
    <div class="row">
        <!-- Order Info -->
        <div class="col-lg-8">
            <!-- Order Items -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-box me-2 text-primary"></i>สินค้าในคำสั่งซื้อ (@totalItems ชิ้น)
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>สินค้า</th>
                                    <th class="text-center">ราคา</th>
                                    <th class="text-center">จำนวน</th>
                                    <th class="text-end">รวม</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderDetails ?? new List<CSI402_Project.Models.Db.OrderDetail>())
                                {
                                    var itemSubtotal = (item.Price ?? 0) * (item.Quantity ?? 0);
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@(string.IsNullOrEmpty(item.Product?.ImageUrl) ? "/images/bike-placeholder.jpg" : item.Product.ImageUrl)" 
                                                     class="rounded me-3" style="width: 60px; height: 60px; object-fit: cover;"
                                                     alt="@item.Product?.Name">
                                                <div>
                                                    <h6 class="mb-1">@item.Product?.Name</h6>
                                                    <small class="text-muted">@item.Product?.Category?.Name</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">฿@item.Price?.ToString("N0")</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end fw-bold text-primary">฿@itemSubtotal.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Order Timeline -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-clock-history me-2 text-primary"></i>สถานะคำสั่งซื้อ
                    </h5>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        <div class="timeline-item active">
                            <div class="timeline-marker bg-success"></div>
                            <div class="timeline-content">
                                <h6 class="mb-1">สั่งซื้อสำเร็จ</h6>
                                <p class="text-muted small mb-0">@Model.OrderDate?.ToString("dd MMM yyyy HH:mm", new System.Globalization.CultureInfo("th-TH"))</p>
                            </div>
                        </div>
                        @if (Model.Status != "รอดำเนินการ")
                        {
                            <div class="timeline-item @(Model.Status == "กำลังจัดส่ง" || Model.Status == "จัดส่งสำเร็จ" ? "active" : "")">
                                <div class="timeline-marker @(Model.Status == "กำลังจัดส่ง" || Model.Status == "จัดส่งสำเร็จ" ? "bg-success" : "bg-secondary")"></div>
                                <div class="timeline-content">
                                    <h6 class="mb-1">กำลังเตรียมสินค้า</h6>
                                    <p class="text-muted small mb-0">พนักงานกำลังเตรียมสินค้าสำหรับจัดส่ง</p>
                                </div>
                            </div>
                        }
                        @if (Model.Status == "จัดส่งสำเร็จ")
                        {
                            <div class="timeline-item active">
                                <div class="timeline-marker bg-success"></div>
                                <div class="timeline-content">
                                    <h6 class="mb-1">จัดส่งสำเร็จ</h6>
                                    <p class="text-muted small mb-0">สินค้าถึงมือคุณแล้ว</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Summary -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 sticky-top" style="top: 100px;">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-receipt me-2"></i>สรุปคำสั่งซื้อ
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>ราคาสินค้า</span>
                        <span>฿@subtotal.ToString("N0")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>จำนวน</span>
                        <span>@totalItems ชิ้น</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span>ค่าจัดส่ง</span>
                        <span class="text-success">ฟรี</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="h5 mb-0">ยอดรวมทั้งหมด</span>
                        <span class="h5 mb-0 text-primary">฿@Model.TotalAmount?.ToString("N0")</span>
                    </div>

                    <div class="d-grid gap-2">
                        <a asp-action="Index" class="btn btn-outline-primary">
                            <i class="bi bi-arrow-left me-2"></i>กลับหน้าคำสั่งซื้อ
                        </a>
                        <a asp-controller="Product" asp-action="Index" class="btn btn-primary">
                            <i class="bi bi-bag me-2"></i>ซื้อสินค้าต่อ
                        </a>
                    </div>
                </div>
            </div>

            <!-- Customer Info -->
            <div class="card shadow-sm border-0 mt-3">
                <div class="card-header bg-light py-3">
                    <h6 class="mb-0">
                        <i class="bi bi-person me-2 text-primary"></i>ข้อมูลลูกค้า
                    </h6>
                </div>
                <div class="card-body">
                    <p class="mb-2">
                        <i class="bi bi-person-circle me-2 text-muted"></i>@Model.User?.Username
                    </p>
                    <p class="mb-2">
                        <i class="bi bi-telephone me-2 text-muted"></i>@Model.User?.Phone
                    </p>
                    <p class="mb-0">
                        <i class="bi bi-geo-alt me-2 text-muted"></i>@Model.User?.Address
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .timeline {
        position: relative;
        padding-left: 30px;
    }
    .timeline::before {
        content: '';
        position: absolute;
        left: 8px;
        top: 0;
        bottom: 0;
        width: 2px;
        background-color: #dee2e6;
    }
    .timeline-item {
        position: relative;
        padding-bottom: 20px;
    }
    .timeline-item:last-child {
        padding-bottom: 0;
    }
    .timeline-marker {
        position: absolute;
        left: -26px;
        width: 18px;
        height: 18px;
        border-radius: 50%;
    }
    .timeline-item.active .timeline-marker::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 8px;
        height: 8px;
        background-color: white;
        border-radius: 50%;
    }
</style>

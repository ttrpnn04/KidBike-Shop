@model CSI402_Project.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "เข้าสู่ระบบ - KidBike Shop";
}

<!-- Breadcrumb -->
<div class="container py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">หน้าแรก</a></li>
            <li class="breadcrumb-item active" aria-current="page">เข้าสู่ระบบ</li>
        </ol>
    </nav>
</div>

<!-- Login Section -->
<section class="py-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8">
                <div class="card shadow border-0">
                    <div class="card-body p-4 p-md-5">
                        <!-- Header -->
                        <div class="text-center mb-4">
                            <div class="mb-3" style="font-size: 3rem;">🚲</div>
                            <h2 class="fw-bold">เข้าสู่ระบบ</h2>
                            <p class="text-muted">ยินดีต้อนรับกลับมา! กรุณาเข้าสู่ระบบเพื่อดำเนินการต่อ</p>
                        </div>

                        <!-- Success Message from Register -->
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i>
                                @TempData["SuccessMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <!-- Login Form -->
                        <form asp-controller="Account" asp-action="Login" method="post">
                            @Html.AntiForgeryToken()
                            
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                            <!-- Username -->
                            <div class="mb-3">
                                <label asp-for="Username" class="form-label fw-semibold">
                                    <i class="bi bi-person me-2 text-primary"></i>@Html.DisplayNameFor(m => m.Username)
                                </label>
                                <input asp-for="Username" class="form-control form-control-lg" placeholder="กรอกชื่อผู้ใช้" />
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>

                            <!-- Password -->
                            <div class="mb-3">
                                <label asp-for="Password" class="form-label fw-semibold">
                                    <i class="bi bi-lock me-2 text-primary"></i>@Html.DisplayNameFor(m => m.Password)
                                </label>
                                <div class="input-group">
                                    <input asp-for="Password" class="form-control form-control-lg" id="password" placeholder="กรอกรหัสผ่าน" />
                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('password', this)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <!-- Remember Me & Forgot Password -->
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                                    <label asp-for="RememberMe" class="form-check-label">
                                        @Html.DisplayNameFor(m => m.RememberMe)
                                    </label>
                                </div>
                                <a href="#" class="text-primary text-decoration-none small">ลืมรหัสผ่าน?</a>
                            </div>

                            <!-- Submit Button -->
                            <div class="d-grid mb-3">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="bi bi-box-arrow-in-right me-2"></i>เข้าสู่ระบบ
                                </button>
                            </div>

                            <!-- Register Link -->
                            <div class="text-center">
                                <p class="text-muted mb-0">
                                    ยังไม่มีบัญชี? 
                                    <a asp-controller="Account" asp-action="Register" class="text-primary fw-semibold text-decoration-none">สมัครสมาชิก</a>
                                </p>
                            </div>
                        </form>

                        <!-- Divider -->
                        <div class="d-flex align-items-center my-4">
                            <hr class="flex-grow-1">
                            <span class="mx-3 text-muted small">หรือ</span>
                            <hr class="flex-grow-1">
                        </div>

                        <!-- Quick Login for Demo -->
                        <div class="text-center">
                            <p class="text-muted small mb-2">ทดลองเข้าสู่ระบบด้วยบัญชีทดสอบ:</p>
                            <button type="button" class="btn btn-outline-secondary w-100" onclick="fillDemoAccount()">
                                <i class="bi bi-person-workspace me-2"></i>บัญชีทดสอบ
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(inputId, button) {
            const input = document.getElementById(inputId);
            const icon = button.querySelector('i');
            
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }

        function fillDemoAccount() {
            document.getElementById('Username').value = 'testuser';
            document.getElementById('password').value = '123456';
        }
    </script>
}

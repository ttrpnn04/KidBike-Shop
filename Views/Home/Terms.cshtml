@{
    ViewData["Title"] = "เงื่อนไขการใช้บริการ - KidBike Shop";
}

<!-- Breadcrumb -->
<div class="container py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">หน้าแรก</a></li>
            <li class="breadcrumb-item active" aria-current="page">เงื่อนไขการใช้บริการ</li>
        </ol>
    </nav>
</div>

<!-- Page Header -->
<section class="py-4">
    <div class="container">
        <div class="section-header text-center">
            <h1 class="section-title">
                <i class="bi bi-file-text text-primary me-2"></i>เงื่อนไขการใช้บริการ
            </h1>
            <p class="section-subtitle">กรุณาอ่านข้อตกลงนี้อย่างละเอียดก่อนใช้บริการ</p>
        </div>
    </div>
</section>

<!-- Terms Content -->
<section class="py-4">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4 p-md-5">
                        <p class="text-muted mb-4">
                            ยินดีต้อนรับสู่ <strong>KidBike Shop</strong> การใช้งานเว็บไซต์นี้ถือว่าคุณยอมรับเงื่อนไขการใช้บริการต่อไปนี้ 
                            หากคุณไม่เห็นด้วยกับข้อตกลงใดๆ กรุณาหยุดใช้งานเว็บไซต์
                        </p>

                        <h5 class="fw-bold mb-3">1. การใช้งานเว็บไซต์</h5>
                        <p class="text-muted mb-4">
                            คุณตกลงที่จะใช้งานเว็บไซต์นี้เพื่อวัตถุประสงค์ที่ถูกต้องตามกฎหมายเท่านั้น 
                            ห้ามใช้เว็บไซต์เพื่อกิจกรรมที่ผิดกฎหมาย หลอกลวง หรือก่อให้เกิดความเสียหายแก่ผู้อื่น
                        </p>

                        <h5 class="fw-bold mb-3">2. บัญชีผู้ใช้</h5>
                        <p class="text-muted mb-4">
                            เมื่อสร้างบัญชีผู้ใช้กับเรา คุณต้อง:
                        </p>
                        <ul class="text-muted mb-4">
                            <li>ให้ข้อมูลที่ถูกต้อง ครบถ้วน และเป็นปัจจุบัน</li>
                            <li>รักษาความปลอดภัยรหัสผ่านของคุณ</li>
                            <li>ไม่เปิดเผยข้อมูลเข้าสู่ระบบให้ผู้อื่น</li>
                            <li>แจ้งเราทันทีหากพบการใช้งานที่ไม่ได้รับอนุญาต</li>
                        </ul>

                        <h5 class="fw-bold mb-3">3. การสั่งซื้อและชำระเงิน</h5>
                        <p class="text-muted mb-4">
                        </p>
                        <ul class="text-muted mb-4">
                            <li>ราคาสินค้าที่แสดงเป็นราคาในเงินบาทไทย (THB) รวมภาษีมูลค่าเพิ่มแล้ว</li>
                            <li>เราขอสงวนสิทธิ์ในการเปลี่ยนแปลงราคาได้ทุกเมื่อโดยไม่ต้องแจ้งให้ทราบล่วงหน้า</li>
                            <li>การสั่งซื้อจะสมบูรณ์เมื่อได้รับการยืนยันการชำระเงิน</li>
                            <li>เราขอสงวนสิทธิ์ในการยกเลิกคำสั่งซื้อหากพบข้อมูลไม่ถูกต้อง</li>
                        </ul>

                        <h5 class="fw-bold mb-3">4. การจัดส่งสินค้า</h5>
                        <p class="text-muted mb-4">
                        </p>
                        <ul class="text-muted mb-4">
                            <li>เราจัดส่งสินค้าทั่วประเทศไทย</li>
                            <li>ระยะเวลาการจัดส่งขึ้นอยู่กับที่อยู่และบริษัทขนส่ง</li>
                            <li>ค่าจัดส่งฟรีสำหรับคำสั่งซื้อที่กำหนด (ตามเงื่อนไขโปรโมชั่น)</li>
                            <li>ลูกค้าต้องตรวจสอบสินค้าเมื่อได้รับและแจ้งปัญหาภายใน 24 ชั่วโมง</li>
                        </ul>

                        <h5 class="fw-bold mb-3">5. การคืนสินค้า</h5>
                        <p class="text-muted mb-4">
                            รายละเอียดการคืนสินค้าอยู่ภายใต้ <a asp-controller="Home" asp-action="Returns">นโยบายการคืนสินค้า</a> 
                            โดยทั่วไปสินค้าสามารถคืนได้ภายใน 7 วันนับจากวันที่ได้รับสินค้า 
                            โดยสินค้าต้องอยู่ในสภาพสมบูรณ์พร้อมกล่องและอุปกรณ์ครบถ้วน
                        </p>

                        <h5 class="fw-bold mb-3">6. การรับประกัน</h5>
                        <p class="text-muted mb-4">
                            สินค้าจักรยานมีการรับประกันคุณภาพตามเงื่อนไขของผู้ผลิต 
                            การรับประกันไม่ครอบคลุมความเสียหายจากการใช้งานผิดวิธี อุบัติเหตุ หรือการดัดแปลง
                        </p>

                        <h5 class="fw-bold mb-3">7. ทรัพย์สินทางปัญญา</h5>
                        <p class="text-muted mb-4">
                            เนื้อหาทั้งหมดบนเว็บไซต์นี้ รวมถึงข้อความ รูปภาพ โลโก้ และการออกแบบ 
                            เป็นทรัพย์สินของ KidBike Shop และได้รับความคุ้มครองตามกฎหมายลิขสิทธิ์
                        </p>

                        <h5 class="fw-bold mb-3">8. ข้อจำกัดความรับผิดชอบ</h5>
                        <p class="text-muted mb-4">
                            KidBike Shop ไม่รับผิดชอบต่อความเสียหายโดยตรง อ้อมอ้าง พิเศษ 
                            หรือเป็นผลสืบเนื่องที่เกิดจากการใช้หรือไม่สามารถใช้งานเว็บไซต์หรือสินค้าได้ 
                            ยกเว้นตามที่กฎหมายกำหนด
                        </p>

                        <h5 class="fw-bold mb-3">9. การเปลี่ยนแปลงเงื่อนไข</h5>
                        <p class="text-muted mb-4">
                            เราขอสงวนสิทธิ์ในการแก้ไขเงื่อนไขการใช้บริการนี้ได้ทุกเมื่อ 
                            การเปลี่ยนแปลงจะมีผลทันทีที่เผยแพร่บนเว็บไซต์
                        </p>

                        <h5 class="fw-bold mb-3">10. กฎหมายที่บังคับใช้</h5>
                        <p class="text-muted mb-0">
                            เงื่อนไขการใช้บริการนี้อยู่ภายใต้กฎหมายของราชอาณาจักรไทย 
                            หากมีข้อพิพาทจะอยู่ในเขตอำนาจศาลของประเทศไทย
                        </p>

                        <div class="mt-4 pt-4 border-top">
                            <p class="text-muted small mb-0">อัปเดตล่าสุด: 18 เมษายน 2026</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@{
    ViewData["Title"] = "ข้อมูลการจัดส่ง - KidBike Shop";
}

<!-- Breadcrumb -->
<div class="container py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">หน้าแรก</a></li>
            <li class="breadcrumb-item active" aria-current="page">ข้อมูลการจัดส่ง</li>
        </ol>
    </nav>
</div>

<!-- Page Header -->
<section class="py-4">
    <div class="container">
        <div class="section-header text-center">
            <h1 class="section-title">
                <i class="bi bi-truck text-primary me-2"></i>ข้อมูลการจัดส่ง
            </h1>
            <p class="section-subtitle">รายละเอียดการจัดส่งสินค้าของเรา</p>
        </div>
    </div>
</section>

<!-- Shipping Info -->
<section class="py-4">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm h-100 text-center p-4">
                    <div class="mb-3" style="font-size: 3rem;">🚚</div>
                    <h5 class="card-title">จัดส่งฟรี</h5>
                    <p class="text-muted mb-0">
                        ส่งฟรีทั่วประเทศไทยทุกคำสั่งซื้อ ไม่มีขั้นต่ำ
                    </p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm h-100 text-center p-4">
                    <div class="mb-3" style="font-size: 3rem;">⚡</div>
                    <h5 class="card-title">จัดส่งรวดเร็ว</h5>
                    <p class="text-muted mb-0">
                        กรุงเทพและปริมณฑล 1-2 วัน<br>ต่างจังหวัด 2-5 วัน
                    </p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm h-100 text-center p-4">
                    <div class="mb-3" style="font-size: 3rem;">📦</div>
                    <h5 class="card-title">บรรจุอย่างดี</h5>
                    <p class="text-muted mb-0">
                        สินค้าห่อหุ้มอย่างดี มาตรฐานการขนส่งจักรยาน
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Delivery Time -->
<section class="py-5 bg-white">
    <div class="container">
        <h3 class="text-center mb-5">ระยะเวลาการจัดส่ง</h3>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="py-3">พื้นที่</th>
                                <th class="py-3">ระยะเวลาโดยประมาณ</th>
                                <th class="py-3">หมายเหตุ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="py-3">กรุงเทพมหานคร</td>
                                <td class="py-3"><span class="badge bg-success">1-2 วันทำการ</span></td>
                                <td class="py-3">จัดส่งโดยบริษัทขนส่งเอกชน</td>
                            </tr>
                            <tr>
                                <td class="py-3">ปริมณฑล (นนทบุรี, สมุทรปราการ, ปทุมธานี)</td>
                                <td class="py-3"><span class="badge bg-success">1-2 วันทำการ</span></td>
                                <td class="py-3">-</td>
                            </tr>
                            <tr>
                                <td class="py-3">ภาคกลาง</td>
                                <td class="py-3"><span class="badge bg-primary">2-3 วันทำการ</span></td>
                                <td class="py-3">-</td>
                            </tr>
                            <tr>
                                <td class="py-3">ภาคเหนือ</td>
                                <td class="py-3"><span class="badge bg-primary">2-4 วันทำการ</span></td>
                                <td class="py-3">ขึ้นอยู่กับระยะทาง</td>
                            </tr>
                            <tr>
                                <td class="py-3">ภาคตะวันออกเฉียงเหนือ</td>
                                <td class="py-3"><span class="badge bg-warning">3-5 วันทำการ</span></td>
                                <td class="py-3">ขึ้นอยู่กับระยะทาง</td>
                            </tr>
                            <tr>
                                <td class="py-3">ภาคใต้</td>
                                <td class="py-3"><span class="badge bg-warning">3-5 วันทำการ</span></td>
                                <td class="py-3">ขึ้นอยู่กับระยะทาง</td>
                            </tr>
                            <tr>
                                <td class="py-3">พื้นที่ห่างไกล / เกาะ</td>
                                <td class="py-3"><span class="badge bg-secondary">5-7 วันทำการ</span></td>
                                <td class="py-3">อาจมีค่าใช้จ่ายเพิ่มเติม</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <p class="text-muted small mt-3">
            <i class="bi bi-info-circle me-1"></i>
            ระยะเวลาดังกล่าวเป็นการประมาณการ อาจมีความล่าช้าได้ในช่วงเทศกาลหรือสถานการณ์พิเศษ
        </p>
    </div>
</section>

<!-- Shipping Process -->
<section class="py-5">
    <div class="container">
        <h3 class="text-center mb-5">ขั้นตอนการจัดส่ง</h3>
        <div class="row g-4">
            <div class="col-md-3">
                <div class="text-center">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.5rem;">
                        <i class="bi bi-check2"></i>
                    </div>
                    <h6 class="fw-bold">1. ยืนยันคำสั่งซื้อ</h6>
                    <p class="small text-muted mb-0">ตรวจสอบและยืนยันการชำระเงิน</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="text-center">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.5rem;">
                        <i class="bi bi-box"></i>
                    </div>
                    <h6 class="fw-bold">2. เตรียมสินค้า</h6>
                    <p class="small text-muted mb-0">ตรวจสอบและบรรจุสินค้าอย่างดี</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="text-center">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.5rem;">
                        <i class="bi bi-truck"></i>
                    </div>
                    <h6 class="fw-bold">3. จัดส่ง</h6>
                    <p class="small text-muted mb-0">ส่งมอบให้บริษัทขนส่ง</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="text-center">
                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.5rem;">
                        <i class="bi bi-house-door"></i>
                    </div>
                    <h6 class="fw-bold">4. รับสินค้า</h6>
                    <p class="small text-muted mb-0">ส่งถึงมือคุณ</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Important Notes -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <h3 class="text-center mb-4">ข้อควรรู้</h3>
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <ul class="list-unstyled mb-0">
                            <li class="mb-3 d-flex">
                                <i class="bi bi-check-circle-fill text-success me-3 flex-shrink-0 mt-1"></i>
                                <span class="text-muted">คำสั่งซื้อที่ยืนยันก่อน 14:00 น. จะจัดส่งภายในวันเดียวกัน หรือวันทำการถัดไป</span>
                            </li>
                            <li class="mb-3 d-flex">
                                <i class="bi bi-check-circle-fill text-success me-3 flex-shrink-0 mt-1"></i>
                                <span class="text-muted">คุณจะได้รับ SMS/Email แจ้งเลขพัสดุเพื่อติดตามสถานะ</span>
                            </li>
                            <li class="mb-3 d-flex">
                                <i class="bi bi-check-circle-fill text-success me-3 flex-shrink-0 mt-1"></i>
                                <span class="text-muted">พนักงานจะโทรนัดหมายก่อนจัดส่ง กรุณาเตรียมตัวรับสินค้า</span>
                            </li>
                            <li class="mb-3 d-flex">
                                <i class="bi bi-exclamation-triangle-fill text-warning me-3 flex-shrink-0 mt-1"></i>
                                <span class="text-muted">หากไม่มีผู้รับสินค้า บริษัทขนส่งจะติดต่อกลับอีกครั้ง หรือส่งกลับศูนย์จัดส่ง</span>
                            </li>
                            <li class="mb-0 d-flex">
                                <i class="bi bi-exclamation-triangle-fill text-warning me-3 flex-shrink-0 mt-1"></i>
                                <span class="text-muted">กรุณาตรวจสอบสินค้าเมื่อได้รับและแจ้งปัญหาภายใน 24 ชั่วโมง</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="py-4">
    <div class="container text-center">
        <p class="text-muted mb-3">มีคำถามเกี่ยวกับการจัดส่ง?</p>
        <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-primary">
            <i class="bi bi-chat-dots me-2"></i>ติดต่อเรา
        </a>
    </div>
</section>

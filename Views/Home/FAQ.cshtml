@{
    ViewData["Title"] = "คำถามที่พบบ่อย - KidBike Shop";
}

<div class="container py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">หน้าแรก</a></li>
            <li class="breadcrumb-item active" aria-current="page">คำถามที่พบบ่อย</li>
        </ol>
    </nav>
</div>

<section class="py-4">
    <div class="container">
        <div class="section-header text-center">
            <h1 class="section-title">
                <i class="bi bi-question-circle text-primary me-2"></i>คำถามที่พบบ่อย
            </h1>
            <p class="section-subtitle">คำตอบสำหรับคำถามที่ลูกค้ามักสอบถาม</p>
        </div>
    </div>
</section>

<section class="py-4">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <ul class="nav nav-pills justify-content-center mb-4" id="faqTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="general-tab" data-bs-toggle="pill" data-bs-target="#general" type="button" role="tab">
                            <i class="bi bi-info-circle me-1"></i>ทั่วไป
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="order-tab" data-bs-toggle="pill" data-bs-target="#order" type="button" role="tab">
                            <i class="bi bi-bag me-1"></i>การสั่งซื้อ
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="shipping-tab" data-bs-toggle="pill" data-bs-target="#shipping" type="button" role="tab">
                            <i class="bi bi-truck me-1"></i>การจัดส่ง
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="product-tab" data-bs-toggle="pill" data-bs-target="#product" type="button" role="tab">
                            <i class="bi bi-bicycle me-1"></i>สินค้า
                        </button>
                    </li>
                </ul>

                <!-- Tab Content -->
                <div class="tab-content" id="faqTabContent">
                    <!-- General FAQ -->
                    <div class="tab-pane fade show active" id="general" role="tabpanel">
                        <div class="accordion" id="faqGeneral">
                            <div class="accordion-item border-0 mb-3 shadow-sm">
                                <h2 class="accordion-header">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#g1">
                                        KidBike Shop คืออะไร?
                                    </button>
                                </h2>
                                <div id="g1" class="accordion-collapse collapse show" data-bs-parent="#faqGeneral">
                                    <div class="accordion-body text-muted">
                                        KidBike Shop เป็นร้านจำหน่ายจักรยานเด็กคุณภาพดี 
                                        เราคัดสรรสินค้าที่ปลอดภัยและเหมาะสมกับแต่ละช่วงวัย 
                                        เพื่อให้ลูกน้อยของคุณได้สนุกกับการขี่จักรยานอย่างปลอดภัย
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item border-0 mb-3 shadow-sm">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#g2">
                                        สินค้ามีมาตรฐานความปลอดภัยหรือไม่?
                                    </button>
                                </h2>
                                <div id="g2" class="accordion-collapse collapse" data-bs-parent="#faqGeneral">
                                    <div class="accordion-body text-muted">
                                        ใช่ สินค้าทุกชิ้นของเราผ่านมาตรฐาน มอก. และมาตรฐานความปลอดภัยสากล 
                                        เราทดสอบสินค้าอย่างเข้มงวนก่อนจำหน่ายเพื่อให้มั่นใจในความปลอดภัยของเด็กๆ
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item border-0 mb-3 shadow-sm">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#g3">
                                        สมัครสมาชิกมีค่าใช้จ่ายหรือไม่?
                                    </button>
                                </h2>
                                <div id="g3" class="accordion-collapse collapse" data-bs-parent="#faqGeneral">
                                    <div class="accordion-body text-muted">
                                        ไม่มีค่าใช้จ่าย การสมัครสมาชิกฟรี และยังได้รับสิทธิพิเศษมากมาย 
                                        เช่น ส่วนลดสมาชิกใหม่ การแจ้งเตือนโปรโมชั่น และการติดตามคำสั่งซื้อได้สะดวก
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item border-0 mb-0 shadow-sm">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#g4">
                                        ติดต่อทีมงานได้ช่องทางไหน?
                                    </button>
                                </h2>
                                <div id="g4" class="accordion-collapse collapse" data-bs-parent="#faqGeneral">
                                    <div class="accordion-body text-muted">
                                        คุณสามารถติดต่อเราได้หลายช่องทาง:
                                        <ul class="mt-2 mb-0">
                                            <li>โทร: 02-123-4567 (จันทร์-เสาร์ 9:00-18:00 น.)</li>
                                            <li>อีเมล: contact@kidbike.com</li>
                                            <li>Line: @@kidbike (พร้อมลิงก์ใน footer)</li>
                                            <li>Facebook: KidBike Shop</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Order FAQ -->
                    <div class="tab-pane fade" id="order" role="tabpanel">
                        <div class="accordion" id="faqOrder">
                            <div class="accordion-item border-0 mb-3 shadow-sm">
                                <h2 class="accordion-header">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#o1">
                                        มีวิธีการชำระเงินอะไรบ้าง?
                                    </button>
                                </h2>
                                <div id="o1" class="accordion-collapse collapse show" data-bs-parent="#faqOrder">
                                    <div class="accordion-body text-muted">
                                        เรารองรับหลายช่องทางการชำระเงิน:
                                        <ul class="mt-2 mb-0">
                                            <li>โอนเงินผ่านธนาคาร</li>
                                            <li>บัตรเครดิต/เดบิต (Visa, MasterCard)</li>
                                            <li>PromptPay/QR Code</li>
                                            <li>เก็บเงินปลายทาง (COD) - มีค่าธรรมเนียมเพิ่ม</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item border-0 mb-3 shadow-sm">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#o2">
                                        สามารถยกเลิกคำสั่งซื้อได้หรือไม่?
                                    </button>
                                </h2>
                                <div id="o2" class="accordion-collapse collapse" data-bs-parent="#faqOrder">
                                    <div class="accordion-body text-muted">
                                        สามารถยกเลิกได้หากสินค้ายังไม่ได้จัดส่ง 
                                        โปรดติดต่อเราทันทีที่ 02-123-4567 หรือผ่านหน้า "คำสั่งซื้อของฉัน" 
                                        หากสินค้าจัดส่งแล้ว คุณสามารถปฏิเสธการรับสินค้าได้
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item border-0 mb-3 shadow-sm">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#o3">
                                        มีส่วนลดหรือโปรโมชั่นอะไรบ้าง?
                                    </button>
                                </h2>
                                <div id="o3" class="accordion-collapse collapse" data-bs-parent="#faqOrder">
                                    <div class="accordion-body text-muted">
                                        เรามีโปรโมชั่นหลากหลาย:
                                        <ul class="mt-2 mb-0">
                                            <li>สมาชิกใหม่ลด 100 บาท (โค้ด: WELCOME100)</li>
                                            <li>ส่งฟรีทั่วไทยทุกคำสั่งซื้อ</li>
                                            <li>ส่วนลดเทศกาลสูงสุด 20%</li>
                                            <li>ติดตามโปรโมชั่นได้ที่หน้า "โปรโมชั่น"</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item border-0 mb-0 shadow-sm">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#o4">
                                        จะทราบได้อย่างไรว่าคำสั่งซื้อสำเร็จ?
                                    </button>
                                </h2>
                                <div id="o4" class="accordion-collapse collapse" data-bs-parent="#faqOrder">
                                    <div class="accordion-body text-muted">
                                        คุณจะได้รับอีเมลยืนยันคำสั่งซื้อทันทีหลังชำระเงิน 
                                        และ SMS แจ้งเลขพัสดุเมื่อสินค้าจัดส่ง 
                                        สามารถตรวจสอบสถานะได้ที่ "คำสั่งซื้อของฉัน"
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Shipping FAQ -->
                    <div class="tab-pane fade" id="shipping" role="tabpanel">
                        <div class="accordion" id="faqShipping">
                            <div class="accordion-item border-0 mb-3 shadow-sm">
                                <h2 class="accordion-header">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#s1">
                                        ค่าจัดส่งเท่าไร?
                                    </button>
                                </h2>
                                <div id="s1" class="accordion-collapse collapse show" data-bs-parent="#faqShipping">
                                    <div class="accordion-body text-muted">
                                        <strong>ส่งฟรี!</strong> เราจัดส่งฟรีทั่วประเทศไทยทุกคำสั่งซื้อ ไม่มีขั้นต่ำ
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item border-0 mb-3 shadow-sm">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#s2">
                                        ใช้เวลานานแค่ไหนถึงจะได้รับสินค้า?
                                    </button>
                                </h2>
                                <div id="s2" class="accordion-collapse collapse" data-bs-parent="#faqShipping">
                                    <div class="accordion-body text-muted">
                                        <ul class="mb-0">
                                            <li>กรุงเทพและปริมณฑล: 1-2 วันทำการ</li>
                                            <li>ภาคกลาง: 2-3 วันทำการ</li>
                                            <li>ต่างจังหวัด: 2-5 วันทำการ</li>
                                            <li>พื้นที่ห่างไกล: 5-7 วันทำการ</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item border-0 mb-3 shadow-sm">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#s3">
                                        สามารถติดตามพัสดุได้หรือไม่?
                                    </button>
                                </h2>
                                <div id="s3" class="accordion-collapse collapse" data-bs-parent="#faqShipping">
                                    <div class="accordion-body text-muted">
                                        ได้ คุณจะได้รับ SMS/Email แจ้งเลขพัสดุเมื่อสินค้าจัดส่ง 
                                        สามารถติดตามได้ที่เว็บไซต์ของบริษัทขนส่ง 
                                        หรือดูสถานะได้ที่ "คำสั่งซื้อของฉัน"
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item border-0 mb-0 shadow-sm">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#s4">
                                        ถ้าไม่มีคนรับสินค้าจะทำอย่างไร?
                                    </button>
                                </h2>
                                <div id="s4" class="accordion-collapse collapse" data-bs-parent="#faqShipping">
                                    <div class="accordion-body text-muted">
                                        พนักงานจะโทรนัดหมายล่วงหน้าก่อนจัดส่ง 
                                        หากไม่มีผู้รับ พนักงานจะติดต่อกลับอีกครั้ง 
                                        หากยังไม่สามารถจัดส่งได้จะนำสินค้ากลับศูนย์จัดส่ง 
                                        และเราจะติดต่อคุณเพื่อนัดหมายใหม่
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Product FAQ -->
                    <div class="tab-pane fade" id="product" role="tabpanel">
                        <div class="accordion" id="faqProduct">
                            <div class="accordion-item border-0 mb-3 shadow-sm">
                                <h2 class="accordion-header">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#p1">
                                        จะเลือกขนาดจักรยานอย่างไรให้เหมาะกับลูก?
                                    </button>
                                </h2>
                                <div id="p1" class="accordion-collapse collapse show" data-bs-parent="#faqProduct">
                                    <div class="accordion-body text-muted">
                                        ดูคำแนะนำได้ที่ <a asp-controller="Home" asp-action="SizeGuide">คำแนะนำการเลือกไซส์</a> 
                                        โดยทั่วไปขึ้นอยู่กับอายุและส่วนสูงของเด็ก:
                                        <ul class="mt-2 mb-0">
                                            <li>1-3 ปี: จักรยานสามล้อ หรือจักรยานบาลานซ์ 10-12 นิ้ว</li>
                                            <li>3-5 ปี: จักรยานสองล้อ 14-16 นิ้ว</li>
                                            <li>5-8 ปี: จักรยานสองล้อ 20 นิ้ว</li>
                                            <li>7-11 ปี: จักรยานสองล้อ 24 นิ้ว</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item border-0 mb-3 shadow-sm">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#p2">
                                        จักรยานมีการรับประกันหรือไม่?
                                    </button>
                                </h2>
                                <div id="p2" class="accordion-collapse collapse" data-bs-parent="#faqProduct">
                                    <div class="accordion-body text-muted">
                                        ใช่ เรามีการรับประกันคุณภาพสินค้าตามเงื่อนไขของผู้ผลิต 
                                        ทั่วไปรับประกันโครงสร้าง 6-12 เดือน 
                                        อะไหล่และอุปกรณ์เสริม 1-3 เดือน 
                                        (ขึ้นอยู่กับแบรนด์และรุ่น)
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item border-0 mb-3 shadow-sm">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#p3">
                                        ถ้าขนาดไม่พอดีจะเปลี่ยนได้หรือไม่?
                                    </button>
                                </h2>
                                <div id="p3" class="accordion-collapse collapse" data-bs-parent="#faqProduct">
                                    <div class="accordion-body text-muted">
                                        ได้ คุณสามารถเปลี่ยนสินค้าได้ภายใน 7 วัน 
                                        โดยสินค้าต้องอยู่ในสภาพสมบูรณ์และไม่ได้ประกอบ 
                                        ดูรายละเอียดที่ <a asp-controller="Home" asp-action="Returns">นโยบายการคืนสินค้า</a>
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item border-0 mb-0 shadow-sm">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#p4">
                                        ควรเริ่มต้นด้วยจักรยานชนิดไหน?
                                    </button>
                                </h2>
                                <div id="p4" class="accordion-collapse collapse" data-bs-parent="#faqProduct">
                                    <div class="accordion-body text-muted">
                                        แนะนำให้เริ่มตามวัย:
                                        <ul class="mt-2 mb-0">
                                            <li><strong>1-2 ปี:</strong> จักรยานสามล้อ - ฝึกการขี่และความคุ้นเคย</li>
                                            <li><strong>2-4 ปี:</strong> จักรยานบาลานซ์ - พัฒนาทักษะการทรงตัว</li>
                                            <li><strong>3-5 ปี:</strong> จักรยานสองล้อมีล้อข้าง - เริ่มฝึกการขี่จริง</li>
                                            <li><strong>5 ปีขึ้นไป:</strong> จักรยานสองล้อธรรมดา</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Still Need Help -->
<section class="py-5" style="background: linear-gradient(135deg, #E8F8F5 0%, #D5F5E3 100%);">
    <div class="container text-center">
        <h4 class="mb-3">ยังไม่พบคำตอบที่ต้องการ?</h4>
        <p class="text-muted mb-4">ทีมงานของเรายินดีช่วยเหลือคุณ</p>
        <a asp-controller="Home" asp-action="Contact" class="btn btn-primary btn-lg">
            <i class="bi bi-chat-dots me-2"></i>ติดต่อเรา
        </a>
    </div>
</section>

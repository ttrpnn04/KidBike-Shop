@model List<CSI402_Project.Models.Db.Promotion>
@{
    ViewData["Title"] = "โปรโมชั่นและส่วนลด";
}

<!-- Breadcrumb -->
<div class="container py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">หน้าแรก</a></li>
            <li class="breadcrumb-item active" aria-current="page">โปรโมชั่น</li>
        </ol>
    </nav>
</div>

<!-- Page Header -->
<div class="container mb-4">
    <div class="section-header">
        <h1 class="section-title">
            <i class="bi bi-tag-fill text-warning me-2"></i>โปรโมชั่นและส่วนลด
        </h1>
        <p class="section-subtitle">รับส่วนลดพิเศษเมื่อซื้อสินค้าจาก KidBike Shop</p>
    </div>
</div>

<div class="container">
    @if (Model.Count == 0)
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-calendar-x fs-1 d-block mb-3"></i>
            <h5>ไม่มีโปรโมชั่นในขณะนี้</h5>
            <p class="mb-3">กรุณากลับมาตรวจสอบใหม่ในภายหลัง</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-arrow-left me-2"></i>กลับหน้าแรก
            </a>
        </div>
    }
    else
    {
        <div class="row g-4 mb-5">
            @foreach (var promo in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-header bg-primary text-white py-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-ticket-perforated fs-1 me-3"></i>
                                <div>
                                    <h5 class="mb-0">@promo.Name</h5>
                                    <small>รหัส: #@promo.PromotionId</small>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="text-center mb-3">
                                @if (promo.Type == "Percentage")
                                {
                                    <h2 class="text-primary mb-0">@promo.DiscountValue%</h2>
                                    <small class="text-muted">ส่วนลด</small>
                                }
                                else if (promo.Type == "FixedAmount")
                                {
                                    <h2 class="text-primary mb-0">฿@promo.DiscountValue?.ToString("N0")</h2>
                                    <small class="text-muted">ส่วนลด</small>
                                }
                                else if (promo.Type == "FreeShipping")
                                {
                                    <h2 class="text-primary mb-0"><i class="bi bi-truck"></i></h2>
                                    <small class="text-muted">ส่งฟรี</small>
                                }
                                else
                                {
                                    <h2 class="text-primary mb-0">@promo.DiscountValue</h2>
                                    <small class="text-muted">ส่วนลด</small>
                                }
                            </div>
                            
                            @if (promo.ConditionAmount.HasValue && promo.ConditionAmount > 0)
                            {
                                <div class="alert alert-light border mb-3">
                                    <i class="bi bi-info-circle me-2"></i>
                                    <strong>เงื่อนไข:</strong> เมื่อซื้อครบ ฿@promo.ConditionAmount?.ToString("N0")
                                </div>
                            }
                            
                            <div class="d-flex align-items-center text-muted small mb-2">
                                <i class="bi bi-calendar3 me-2"></i>
                                <span>เริ่ม: @promo.StartDate?.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="d-flex align-items-center text-muted small">
                                <i class="bi bi-calendar3 me-2"></i>
                                <span>สิ้นสุด: @promo.EndDate?.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-0 pb-3">
                            <a asp-controller="Product" asp-action="Index" class="btn btn-primary w-100">
                                <i class="bi bi-bag me-2"></i>ซื้อสินค้าเลย
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
        
        <!-- Promotion Banner -->
        <div class="promo-banner mb-5">
            <h3 class="promo-title">🎉 อย่าพลาดโปรโมชั่นดีๆ!</h3>
            <p class="mb-0">สมัครสมาชิกเพื่อรับข่าวสารโปรโมชั่นก่อนใคร</p>
            <div class="mt-3">
                <a asp-controller="Account" asp-action="Register" class="btn btn-light">
                    <i class="bi bi-person-plus me-2"></i>สมัครสมาชิก
                </a>
            </div>
        </div>
    }
</div>
